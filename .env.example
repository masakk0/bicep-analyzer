# Select a LiteLLM provider/model that supports tool calling.
# Examples: openai/gpt-4.1-mini, anthropic/claude-sonnet-4-5,
#           ollama/llama3.1, azure/gpt-4.1-mini
LLM_MODEL=openai/gpt-4.1-mini
# Set a real key for hosted providers. Keep empty for local providers.
LLM_API_KEY=

# Required only for self-hosted or OpenAI-compatible endpoints, such as Ollama.
# LLM_API_BASE=http://localhost:11434

# Required only by providers that use an API version, such as Azure OpenAI.
# LLM_API_VERSION=2024-10-21